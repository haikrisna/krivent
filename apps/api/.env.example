NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_USER=krivent
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=krivent
POSTGRES_PORT=5432
# URL-encode special characters in the password. Keep these credentials in sync.
DATABASE_URL=postgresql://krivent:change_me_local_only@localhost:5432/krivent?schema=public
# Optional: configure both keys to enable Observe. Never commit real keys.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Required. Generate locally: openssl rand -hex 32. No fallback secret.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=http://localhost:4000
AUTH_JWT_AUDIENCE=krivent-api
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_SESSION_TTL_DAYS=30
AUTH_LOGIN_LIMIT=5
# Initial Admin credentials are read from stdin by npm run admin:bootstrap.
# Never put a default password here or pass passwords as command-line arguments.

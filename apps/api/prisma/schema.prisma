generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
}

enum UserRole {
  ADMIN
  SALES_STAFF
  WAREHOUSE_STAFF
}

model User {
  role           UserRole        @default(SALES_STAFF)
  authSessions   AuthSession[]
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique @db.VarChar(254)
  name           String          @db.VarChar(120)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  leads          Lead[]
  customers      Customer[]
  crmActivities  CrmActivity[]
  followUps      FollowUp[]
  sales          Sale[]
  stockMovements StockMovement[]

  @@map("users")
}

model Category {
  isActive    Boolean   @default(true) @map("is_active")
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]

  @@map("categories")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  categoryId     String          @map("category_id") @db.Uuid
  sku            String          @unique @db.VarChar(64)
  name           String          @db.VarChar(200)
  description    String?
  costPrice      Decimal         @map("cost_price") @db.Decimal(18, 2)
  sellingPrice   Decimal         @map("selling_price") @db.Decimal(18, 2)
  stockQuantity  Int             @default(0) @map("stock_quantity")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Customer {
  ownerId         String?       @map("owner_id") @db.Uuid
  owner           User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  leadId          String?       @unique @map("lead_id") @db.Uuid
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contactName     String?       @map("contact_name") @db.VarChar(120)
  dedupKey        String?       @unique @map("dedup_key") @db.VarChar(120)
  normalizedEmail String?       @unique @map("normalized_email") @db.VarChar(254)
  isActive        Boolean       @default(true) @map("is_active")
  activities      CrmActivity[]
  followUps       FollowUp[]
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(32)
  name            String        @db.VarChar(120)
  email           String?       @db.VarChar(254)
  phone           String?       @db.VarChar(32)
  address         String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales           Sale[]

  @@index([ownerId, isActive])
  @@index([name])
  @@map("customers")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  invoiceNumber String     @unique @map("invoice_number") @db.VarChar(64)
  customerId    String?    @map("customer_id") @db.Uuid
  createdById   String     @map("created_by_id") @db.Uuid
  status        SaleStatus @default(DRAFT)
  totalAmount   Decimal    @default(0) @map("total_amount") @db.Decimal(18, 2)
  notes         String?
  soldAt        DateTime   @default(now()) @map("sold_at") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy     User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items         SaleItem[]

  @@index([customerId])
  @@index([createdById])
  @@index([status, soldAt])
  @@index([soldAt])
  @@map("sales")
}

model SaleItem {
  id             String          @id @default(uuid()) @db.Uuid
  saleId         String          @map("sale_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal         @map("unit_price") @db.Decimal(18, 2)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([saleId, productId])
  @@unique([id, productId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  createdById String            @map("created_by_id") @db.Uuid
  saleItemId  String?           @map("sale_item_id") @db.Uuid
  type        StockMovementType
  // Signed delta: incoming positive, outgoing negative.
  quantity    Int
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  saleItem    SaleItem?         @relation(fields: [saleItemId, productId], references: [id, productId], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([createdById])
  @@index([saleItemId, productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  // SHA-256 digest of 32 random bytes; the raw token is never persisted.
  hash      String      @id @db.Char(64)
  sessionId String      @map("session_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?   @map("used_at") @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model AdminBootstrap {
  id          String   @id @db.VarChar(32)
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  @@map("admin_bootstrap")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Lead {
  id          String        @id @default(uuid()) @db.Uuid
  companyName String        @map("company_name") @db.VarChar(120)
  contactName String        @map("contact_name") @db.VarChar(120)
  email       String?       @db.VarChar(254)
  phone       String?       @db.VarChar(32)
  source      String        @db.VarChar(80)
  ownerId     String        @map("owner_id") @db.Uuid
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  stage       LeadStage     @default(NEW)
  notes       String?
  lostReason  String?       @map("lost_reason")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer    Customer?
  activities  CrmActivity[]
  followUps   FollowUp[]

  @@index([ownerId, isActive, stage])
  @@index([source])
  @@index([createdAt, id])
  @@map("leads")
}

model CrmActivity {
  id         String       @id @default(uuid()) @db.Uuid
  leadId     String?      @map("lead_id") @db.Uuid
  customerId String?      @map("customer_id") @db.Uuid
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorId    String       @map("actor_id") @db.Uuid
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type       ActivityType
  note       String
  occurredAt DateTime     @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([leadId, occurredAt, id])
  @@index([customerId, occurredAt, id])
  @@map("crm_activities")
}

model FollowUp {
  id         String         @id @default(uuid()) @db.Uuid
  leadId     String?        @map("lead_id") @db.Uuid
  customerId String?        @map("customer_id") @db.Uuid
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assigneeId String         @map("assignee_id") @db.Uuid
  assignee   User           @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  note       String
  dueAt      DateTime       @map("due_at") @db.Timestamptz(3)
  status     FollowUpStatus @default(PENDING)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([assigneeId, status, dueAt])
  @@index([leadId, dueAt])
  @@index([customerId, dueAt])
  @@map("follow_ups")
}
